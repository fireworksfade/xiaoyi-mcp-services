# IoT Control MCP
CONTROL_HOST=127.0.0.1
CONTROL_PORT=9002
CONTROL_DATABASE_PATH=data/iot_control.db
CONTROL_COMMAND_TIMEOUT_SECONDS=30
CONTROL_VERIFY_WINDOW_SECONDS=60
CONTROL_PROPOSAL_TTL_MINUTES=30
CONTROL_MCP_BEARER_TOKEN=
